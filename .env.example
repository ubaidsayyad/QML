# ==============================================================================
# Hybrid Quantum-Classical ML Platform (SIH26139) - Environment Configuration
# Copy this file to '.env' and populate your local credentials and settings.
# ==============================================================================

# Quantum Execution Backend
# Options:
#   - simulator        : Fast local NumPy statevector simulator (Offline / Zero network latency)
#   - qiskit_simulator : Qiskit 2.5 Statevector simulation (Industry-standard circuit verification)
#   - ibm_hardware     : Real IBM Quantum physical processor (Cloud QPU via Qiskit Runtime)
QUANTUM_BACKEND=simulator

# IBM Quantum Cloud API Credentials (Optional - required only if QUANTUM_BACKEND=ibm_hardware)
# Obtain a free 64-character API token from https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=your_64_character_ibm_quantum_api_token_here
QISKIT_IBM_TOKEN=your_64_character_ibm_quantum_api_token_here

# Specific IBM Quantum QPU Backend Name (Optional - leave blank for automatic least_busy QPU selection)
# Examples: 'ibm_brisbane', 'ibm_kyoto', 'ibm_osaka'
IBM_QUANTUM_BACKEND_NAME=

# Web Application Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=1
FLASK_SECRET_KEY=sih26139-hybrid-quantum-secret-key-change-in-production

# Default Training Hyperparameters
DEFAULT_CIRCUIT_EPOCHS=30
DEFAULT_LEARNING_RATE=0.40
DEFAULT_SUBSAMPLE_SIZE=140
